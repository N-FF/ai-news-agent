# ===========================================
# 通义千问 API
# ===========================================
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===========================================
# Tavily 联网搜索（可选，用于补充实时新闻）
# ===========================================
TAVILY_API_KEY=tvly-xxxxxxxx

# ===========================================
# 邮件推送（QQ邮箱为例）
# ===========================================
SMTP_EMAIL=your_email@qq.com
SMTP_PASSWORD=your_smtp_auth_code
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465

# 高风险：仅可信本地环境演示时才设为 true；公网部署请保持 false
ENABLE_BASH_TOOL=false

# ===========================================
# 服务配置
# ===========================================
PORT=8000

# ===========================================
# 新闻RSS源（逗号分隔，可自行增减）
# ===========================================
RSS_FEEDS=https://www.jiqizhixin.com/rss,https://huggingface.co/blog/feed.xml
